{
  "name": "SentinelCDC Codespace Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {
      "version": "latest",
      "enableDockerInDockerDockerTokens": true
    }
  },
  "forwardPorts": [8000, 9090, 5432, 27017],
  "portsAttributes": {
    "8000": {
      "label": "SentinelCDC FastAPI Engine",
      "onAutoForward": "notify"
    },
    "9090": {
      "label": "Prometheus Graph & Query UI",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "docker compose up -d --build"
}

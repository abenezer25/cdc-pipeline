{
  "name": "SentinelCDC Codespace Environment",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/app",
  "forwardPorts": [8000, 9090, 5432, 27017],
  "portsAttributes": {
    "8000": {
      "label": "SentinelCDC FastAPI & Dashboard",
      "onAutoForward": "notify"
    },
    "9090": {
      "label": "Prometheus Graph & Query UI",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python"
      ]
    }
  }
}
